@page "/"

<body>
<nav class="sidebar">
    <ul class="sidebar-nav">
        <li><a href="/dashboard" class="active"> Dashboard</a></li>
        <li><a href="/transactions">All Transactions</a></li>
        <li><a href="/tags">Manage Tags</a></li>
        <li><a href="/debts">Manage Debts</a></li>
    </ul>
    <a href="/" class="logout-btn">Logout</a>
</nav>

<main class="dashboard-container">
    <header class="dashboard-header">
        <h1>Dashboard</h1>
        <div class="header-actions">
            <button class="add-transaction-btn">
                <a href="/transcationForm"> Add Transaction </a>
            </button>
            <div class="user-name">Divya Shrestha</div>
        </div>
    </header>

    <!-- Summary Stats -->
    <div class="stats-grid">
        <div class="stat-card inflow">
            <h3>Total Inflow</h3>
            <div class="amount">@TotalCredit</div>
        </div>
        <div class="stat-card outflow">
            <h3>Cash Outflow</h3>
            <div class="amount">@TotalDebit</div>
        </div>
        <div class="stat-card due-debt">
            <h3>Due Debt</h3>
            <div class="amount">@DueDebt</div>
        </div>
        <div class="stat-card cleared-debt">
            <h3>Cleared Debt</h3>
            <div class="amount">@ClearedDebt</div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-container">
        <!-- Donut Chart -->
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Transaction Types Distribution</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudChart ChartType="ChartType.Donut" TData="int" Labels="@TransactionLabels" Data="@TransactionData" />
            </MudCardContent>
        </MudCard>

        <!-- Bar Chart -->
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Inflow vs Outflow</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudChart ChartType="ChartType.Bar" TData="decimal" Labels="@BarChartLabels" Data="@BarChartData" />
            </MudCardContent>
        </MudCard>
    </div>
</main>
</body>