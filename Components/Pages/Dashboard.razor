@page "/dashboard"

<body>
<nav class="sidebar">
    <ul class="sidebar-nav">
        <li><a href="/dashboard" class="active"> Dashboard</a></li>
        <li><a href="/transactions">All Transactions</a></li>
    </ul>
    <a href="/" class="logout-btn">Logout</a>
</nav>

<main class="dashboard-container">
    <header class="dashboard-header">
        <h1>Dashboard</h1>
        <div class="header-actions">
            <button class="add-transaction-btn"> <a href="/transcationForm"> Add Transaction  </a>  </button>
            <div class="user-name">Divya Shrestha</div>
        </div>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Inflow</h3>
            <div class="amount">$5,240</div>
        </div>
        <div class="stat-card">
            <h3>Cash Outflow</h3>
            <div class="amount">$3,120</div>
        </div>
        <div class="stat-card">
            <h3>Due Debt</h3>
            <div class="amount">$890</div>
        </div>
        <div class="stat-card">
            <h3>Clear Debt</h3>
            <div class="amount">$1,230</div>
        </div>
    </div>

    <div class="charts-container">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Inflow Data</h3>
                <div class="chart-filters">
                    <select class="date-filter">
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                        <option>Last 90 days</option>
                    </select>
                    <button class="filter-btn">Filter</button>
                </div>
            </div>
            <div class="chart-area" id="inflow-chart"></div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3>Outflow Data</h3>
                <div class="chart-filters">
                    <select class="date-filter">
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                        <option>Last 90 days</option>
                    </select>
                    <button class="filter-btn">Filter</button>
                </div>
            </div>
            <div class="chart-area" id="outflow-chart"></div>
        </div>
    </div>
</main>
</body>