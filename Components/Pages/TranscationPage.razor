@page "/transactions"

<body>
<nav class="sidebar">
    <ul class="sidebar-nav">
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/transactions" class="active">All Transactions</a></li>
        <li><a href="/tags">Manage Tags</a></li>  
        <li><a href="/debts">Manage Debts</a></li>
    </ul>
    <a href="/" class="logout-btn">Logout</a>
</nav>

<main class="transactions-container">
        <header class="transactions-header">
            <h1>All Transactions</h1>
            <button class="add-transaction-btn">
                <a href="/transcationForm"> Add Transaction </a>
            </button>
            <button class="export-btn" @onclick="ExportToJson">Export to JSON</button>
        </header>
        
        <div class="filter-controls">
            <input type="text" placeholder="Search by Source Name or Amount" @bind="SearchQuery" class="filter-input" />
            <div>
                <label>Start Date:</label>
                <input type="date" @bind="StartDate" />
            </div>
            <div>
                <label>End Date:</label>
                <input type="date" @bind="EndDate" />
            </div>
            <select @bind="SearchType" class="filter-select">
                <option value="">All Types</option>
                <option value="Credit">Credit</option>
                <option value="Debit">Debit</option>
            </select>
            <button class="apply-filters-btn" @onclick="ApplyFilters">Apply Filters</button>
        </div>
        
        <div class="transactions-table">
            <table>
                <thead>
                    <tr>
                        <th>Transaction Type</th>
                        <th>Date</th>
                        <th>Source</th>
                        <th>Amount</th>
                        <th>Note</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredTransactions != null && FilteredTransactions.Any())
                    {
                        @foreach (var transaction in FilteredTransactions)
                        {
                            <tr>
                                <td>@transaction.Type</td>
                                <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                                <td>@string.Join(", ", transaction.Source)</td>
                                <td>@transaction.TransactionAmount</td>
                                <td>@transaction.Note</td>
                                <td>
                                    <button class="action-btn edit-btn" @onclick="() => EditTransaction(transaction.Id)">Edit</button>
                                    <button class="action-btn delete-btn" @onclick="() => DeleteTransaction(transaction.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No transactions match your search criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
</main>
</body>