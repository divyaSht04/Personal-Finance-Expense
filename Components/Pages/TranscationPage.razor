@page "/transactions"

<body>
    <nav class="sidebar">
        <ul class="sidebar-nav">
            <li><a href="/dashboard" class="active">Dashboard</a></li>
            <li><a href="/history">History</a></li>
            <li><a href="/transactions">All Transactions</a></li>
        </ul>
        <a href="/" class="logout-btn">Logout</a>
    </nav>

    <main class="transactions-container">
        <header class="transactions-header">
            <h1>All Transactions</h1>
            <button class="export-btn">Export</button>
        </header>

        <div class="transactions-table">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Transaction Type</th>
                        <th>Date</th>
                        <th>Source</th>
                        <th>Note</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Table rows will be populated dynamically -->
                </tbody>
            </table>
        </div>

        <div class="transaction-highlights">
            <section class="highest-transactions">
                <h2>Highest Transactions</h2>
                <div class="transaction-cards">
                    <!-- Highest transaction cards -->
                </div>
            </section>

            <section class="lowest-transactions">
                <h2>Lowest Transactions</h2>
                <div class="transaction-cards">
                   
                </div>
            </section>
        </div>
    </main>
</body>