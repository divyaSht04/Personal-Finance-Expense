@page "/transcation"

<body>
<div class="container">
    <form class="transaction-form">
        <h1>Transaction Form</h1>

        <div class="form-group">
            <label for="amount">Amount</label>
            <input type="number" id="amount" name="amount" placeholder="Enter amount" required>
        </div>

        <div class="form-group">
            <label for="source">Source</label>
            <input type="text" id="source" name="source" placeholder="Enter source" required>
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" required>
        </div>

        <div class="form-group">
            <label for="note">Note</label>
            <textarea id="note" name="note" placeholder="Enter note" rows="4"></textarea>
        </div>

        <div class="form-group">
            <label>Transaction Type</label>
            <div class="transaction-options">
                <div class="transaction-option">
                    <input type="radio" id="credit" name="type" value="credit" required>
                    <label for="credit">Credit</label>
                </div>
                <div class="transaction-option">
                    <input type="radio" id="debit" name="type" value="debit">
                    <label for="debit">Debit</label>
                </div>
                <div class="transaction-option">
                    <input type="radio" id="debt" name="type" value="debt">
                    <label for="debt">Debt</label>
                </div>
            </div>
        </div>

        <button type="submit">Submit Transaction</button>
    </form>
</div>
</body>